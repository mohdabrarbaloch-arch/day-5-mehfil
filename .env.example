# ─────────────────────────────────────────────────────────────
# Mehfil — environment variables
# Copy to .env and fill in. Never commit .env.
# ─────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────
APP_NAME=Mehfil
# development | production | test
ENVIRONMENT=development
DEBUG=false

# ── Security (REQUIRED in production) ────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# If unset, a random key is generated at boot and tokens will NOT survive a
# restart. The app logs a warning when this happens.
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# bcrypt cost. 12 is the default; lower only in tests.
BCRYPT_ROUNDS=12

# ── Database ─────────────────────────────────────────────────
# Postgres (docker-compose default):
#   postgresql://mehfil:mehfil@db:5432/mehfil
# SQLite fallback (local dev):
#   sqlite:///./mehfil.db
# On Vercel, SQLite lives in /tmp and is wiped between cold starts — use
# Postgres for anything you want to keep.
DATABASE_URL=sqlite:///./mehfil.db

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated. Never use * in production.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ── Rate limits (slowapi syntax) ─────────────────────────────
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_MESSAGES=30/minute

# ── Engine ───────────────────────────────────────────────────
# Total context window to plan against, in tokens.
CONTEXT_BUDGET=4096
# Tokens reserved for the reply (never given to the prompt).
MAX_REPLY_TOKENS=512
# Tokens the lorebook may consume per turn.
LORE_BUDGET=600

# ── Generation backend ───────────────────────────────────────
# auto | ollama | openai | none
#   auto   — use openai if OPENAI_BASE_URL+KEY are set, else ollama if
#            OLLAMA_BASE_URL is set, else none
#   none   — no model is called; replies are labelled simulated
LLM_BACKEND=auto
LLM_TEMPERATURE=0.8
LLM_MAX_TOKENS=512

# Ollama (local, free, no key)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Any OpenAI-compatible endpoint: OpenAI, Groq, Together, vLLM, LM Studio,
# llama.cpp server. Set both to enable.
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Limits ───────────────────────────────────────────────────
MAX_CHARACTERS_PER_USER=100
MAX_MESSAGE_CHARS=8000
MAX_CARD_BYTES=512000
